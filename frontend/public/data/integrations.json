{
  "description": "Connections to other teams. Each one has a local default (works offline) and an external source that can be switched in Settings. See docs/INTEGRATION.md.",
  "driverInput": {
    "defaultSource": "local",
    "sources": [
      {
        "id": "local",
        "label": "Keyboard & touch"
      },
      {
        "id": "wheel",
        "label": "External steering wheel (CARLA team)"
      }
    ],
    "wheel": {
      "transport": "websocket",
      "url": "ws://localhost:8765",
      "reconnectSeconds": 3,
      "staleMs": 500,
      "stateIntervalMs": 100
    }
  },
  "routes": {
    "defaultSource": "backend",
    "sources": [
      {
        "id": "local",
        "label": "Sample routes (routes.json)"
      },
      {
        "id": "backend",
        "label": "Backend API (Tao)"
      }
    ],
    "backend": {
      "baseUrl": "",
      "path": "/api/routes",
      "timeoutMs": 15000,
      "placeSearch": {
        "description": "Start/destination search boxes. Photon = OpenStreetMap place search, free and without a key (fair use).",
        "url": "https://photon.komoot.io/api/",
        "limit": 6,
        "minChars": 2,
        "debounceMs": 350,
        "lang": "en",
        "biasLatLon": [
          60.9827,
          25.6612
        ],
        "biasNote": "Results near Lahti come first; places elsewhere still work."
      }
    }
  }
}
